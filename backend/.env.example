APP_ENV=development
APP_PORT=8080
APP_CORS_ORIGINS=*
APP_STATIC_TOKEN=dev-token
APP_JWT_SECRET=replace-with-secure-secret
DATABASE_URL=postgres://postgres:postgres@localhost:5432/wealthos?sslmode=disable
REQUEST_ID_HEADER=X-Request-ID
LOG_LEVEL=debug
SEPAY_WEBHOOK_SECRET=replace-with-sepay-webhook-secret
SEPAY_BANKHUB_CLIENT_ID=
SEPAY_BANKHUB_CLIENT_SECRET=
SEPAY_BANKHUB_COMPANY_XID=
SEPAY_BANKHUB_IPN_API_KEY=
# Override only for sandbox/test; production defaults to https://bankhub-api.sepay.vn
SEPAY_BANKHUB_BASE_URL=https://bankhub-api.sepay.vn
# Pilot only: comma-separated provider bank codes. Leave empty to disable new
# Bank Hub account activation until an explicit rollout allowlist is supplied.
SEPAY_BANKHUB_PILOT_BANK_CODES=MBB,TPB,VCB
