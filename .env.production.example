# Copy this file to .env.production on the VPS, then replace every value marked
# CHANGE_ME. This file is intentionally safe to commit; do not commit the copy.
APP_ENV=production
APP_PORT=8080
APP_SEED_DEMO=false
APP_CORS_ORIGINS=http://110.172.29.117:2001
APP_JWT_SECRET=CHANGE_ME_GENERATE_WITH_openssl_rand_hex_48
APP_JWT_TTL_HOURS=24
LOG_LEVEL=info
REDIS_URL=redis://finora-redis:6379/0

# Required because production accounts use email verification.
SMTP_HOST=CHANGE_ME_SMTP_HOST
SMTP_PORT=587
SMTP_USERNAME=CHANGE_ME_SMTP_USERNAME
SMTP_PASSWORD=CHANGE_ME_SMTP_PASSWORD
SMTP_FROM=CHANGE_ME_FROM_ADDRESS
SMTP_FROM_NAME=Finora
